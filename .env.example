# 复制成 .env(已在 .gitignore 里,不会被提交)。
# 线上把同样这几个键写进 GitHub Secrets。

# ---- 必填 ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
STRIPE_API_KEY=rk_live_...        # 用受限密钥(Restricted key),只勾只读权限
OPENAI_API_KEY=

# ---- Xero 授权(免费的标准 OAuth 路径)----
# 本地跑一次 `python authorize.py` 会生成它并存进 .xero_token.json,
# 同时打印出来供你粘进 GitHub Secrets。
# 注意:每次使用都会轮换,脚本自动写回,你不用手动维护。
XERO_REFRESH_TOKEN=

# 授权关联了多个 Xero 组织时,指定用哪个。只有一个组织就留空。
XERO_TENANT_ID=

# ---- GitHub Actions 专用(本地不用填)----
# fine-grained PAT,权限只需要该仓库的 Secrets: Read and write。
# 用途:把轮换后的新 refresh token 写回 Secret。没有它,60 天后要重新授权。
# 在 GitHub Secrets 里存成 GH_PAT。
# GH_PAT=

# ---- 可选:Google Sheet 归档 ----
# 服务账号 JSON 整个粘进来(一行),并把 Sheet 共享给该服务账号邮箱(编辑者)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ---- 可选:邮件 ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                    # Gmail 要用「应用专用密码」,不是登录密码

# ---- 可选:scope 覆盖 ----
# 默认已是颗粒化(granular)scope,新建的 app 直接可用,一般不用动。
# 只有你的 app 建于 2026 年 3 月之前、且仍在用打包 scope 时才需要覆盖。
# XERO_SCOPES=
